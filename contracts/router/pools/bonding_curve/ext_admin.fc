;; messages from admin

(int) handle_ext_admin_messages() impure inline {
    slice in_msg_body = ctx.at(BODY);

    if ctx.at(OPCODE) == op::set_params {
        int coeff_a = in_msg_body~load_coins();
        int coeff_b = in_msg_body~load_coins();
        int token_for_curve = in_msg_body~load_coins();
        slice creator_address = in_msg_body~load_msg_addr();
        slice swap_address = in_msg_body~load_msg_addr();
        int swap_address_expiration = in_msg_body~load_uint32();
        slice extra_info = in_msg_body~load_slice_ref();
        slice left_jetton_wallet = extra_info~load_msg_addr();
        slice right_jetton_wallet = extra_info~load_msg_addr();
        slice excesses_recipient = get_excesses_address(extra_info~load_msg_addr());
        extra_info.end_parse();
        in_msg_body.end_parse();

        ;; check gas
        ;; -> Router -> Pool ->
        throw_unless(error::insufficient_gas, ctx.at(MSG_VALUE) > ctx.at(FWD_FEE) * 3
            + storage_fee::router + gas::router::set_params
            + storage_fee::pool + gas::pool::internal_set_params);

        ;; check params
        throw_unless(error::invalid_amount, coeff_a > 0);
        throw_unless(error::invalid_amount, coeff_b > 0);
        throw_if(error::invalid_amount, (token_for_curve <= 0) | (token_for_curve > 100));
        throw_if(error::invalid_amount, (token_for_curve <= 0) | (token_for_curve > 100));

        throw_if(error::invalid_token, equal_slices(left_jetton_wallet, right_jetton_wallet));

        throw_unless(error::wrong_workchain, left_jetton_wallet.address::check_workchain(params::workchain)
            & right_jetton_wallet.address::check_workchain(params::workchain)
            & excesses_recipient.address::check_workchain(params::workchain)
            & swap_address.address::check_workchain(params::workchain)
            & creator_address.address::check_workchain(params::workchain));

        var pool = contracts::from_sources(
            pool_idata(
                my_address(),
                left_jetton_wallet,
                right_jetton_wallet,
                storage::jetton_lp_wallet_code,
                storage::lp_account_code
            ),
            storage::pool_code
        );

        reserves::max_balance(storage_fee::router);
        msgs::send_with_stateinit(
            0,
            pool~address(params::workchain),
            pool~state_init(),
            pool::internal_set_params(
                excesses_recipient,
                coeff_a,
                coeff_b,
                token_for_curve,
                creator_address,
                swap_address,
                swap_address_expiration
            ),
            CARRY_ALL_BALANCE
        );
        return (true);
    }

    return (false);
}
