_ get_pool_data() method_id {
    storage::load();
    return (
        storage::is_locked,
        storage::router_address,
        storage::total_supply_lp,
        storage::reserve0,
        storage::reserve1,
        storage::token0_address,
        storage::token1_address,
        storage::protocol_fee_address,
        storage::collected_token0_protocol_fee,
        storage::collected_token1_protocol_fee,
        storage::exp_A_coeff,
        storage::exp_B_coeff,
        storage::ct_for_curve_phase,
        storage::bc_swap_address,
        storage::bc_swap_address_expiration
    );
}
