global int storage::exp_A_coeff;
global int storage::exp_B_coeff;
global int storage::base_usd_rate;
global int storage::ct_for_curve_phase;
global int storage::bc_lp_fee;
global int storage::bc_protocol_fee;
global slice storage::bc_swap_address;

() storage::load() impure inline {
    slice ds = get_data().begin_parse();
    storage::is_locked = ds~load_bool();

    cell pool_data = ds~load_ref();
    slice pd = pool_data.begin_parse();
    storage::reserve0 = pd~load_coins();
    storage::reserve1 = pd~load_coins();
    storage::total_supply_lp = pd~load_coins();
    storage::collected_token0_protocol_fee = pd~load_coins();
    storage::collected_token1_protocol_fee = pd~load_coins();
    storage::protocol_fee_address = pd~load_msg_addr();
    storage::lp_fee = pd~load_uint(16);
    storage::protocol_fee = pd~load_uint(16);
    pd.end_parse();

    cell bc_data = ds~load_ref();
    slice bc = bc_data.begin_parse();
    storage::bc_lp_fee = bc~load_uint(16);
    storage::bc_protocol_fee = bc~load_uint(16);
    storage::exp_A_coeff = bc~load_uint(<%= calcExpACoeffSize %>);
    storage::exp_B_coeff = bc~load_uint(<%= calcExpBCoeffSize %>);
    storage::base_usd_rate = bc~load_uint(<%= calcBaseUSDRateSize %>);
    storage::ct_for_curve_phase = bc~load_coins();
    storage::bc_swap_address = bc~load_msg_addr();
    bc.end_parse();

    storage::_static = ds~load_ref();
    slice static_data = storage::_static.begin_parse();
    storage::router_address = static_data~load_msg_addr();
    storage::token0_address = static_data~load_msg_addr();
    storage::token1_address = static_data~load_msg_addr();
    storage::jetton_lp_wallet_code = static_data~load_ref();
    storage::lp_account_code = static_data~load_ref();
    static_data.end_parse();

    ds.end_parse();
}

() storage::save() impure inline {
    set_data(begin_cell()
        .store_bool(storage::is_locked)
        .store_ref(begin_cell()
            .store_coins(storage::reserve0)
            .store_coins(storage::reserve1)
            .store_coins(storage::total_supply_lp)
            .store_coins(storage::collected_token0_protocol_fee)
            .store_coins(storage::collected_token1_protocol_fee)
            .store_slice(storage::protocol_fee_address)
            .store_uint(storage::lp_fee, 16)
            .store_uint(storage::protocol_fee, 16)
            .end_cell())
        .store_ref(begin_cell()
            .store_uint(storage::bc_lp_fee, 16)
            .store_uint(storage::bc_protocol_fee, 16)
            .store_uint(storage::exp_A_coeff, <%= calcExpACoeffSize %>)
            .store_uint(storage::exp_B_coeff, <%= calcExpBCoeffSize %>)
            .store_uint(storage::base_usd_rate, <%= calcBaseUSDRateSize %>)
            .store_coins(storage::ct_for_curve_phase)
            .store_slice(storage::bc_swap_address)
            .end_cell())
        .store_ref(storage::_static)
    .end_cell());
}
