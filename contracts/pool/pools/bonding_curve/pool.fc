
const error::unauthorized_swap_address = 5108;

global slice router_settings;

(int, int, int, int) pool::get_swap_out(int _side, int _ref_value, int _amount_in, int _reserve_in, int _reserve_out) inline {
    int protocol_fee_out = 0;
    int protocol_fee_ct = 0;
    int ref_fee_out = 0;
    int lp_fee = router_settings~load_uint(16);
    int protocol_fee = router_settings~load_uint(16);
    int bc_lp_fee = router_settings~load_uint(16);
    int bc_protocol_fee = router_settings~load_uint(16);
    int protocol_fee_pct = router_settings~load_uint(16);
    int base_usd_rate = router_settings~load_coins();

    if (storage::ct_for_curve_phase != 0) {
        if ((storage::bc_swap_address_expiration >= now()) & (storage::bc_swap_address.preload_uint(2) != 0)) {
            slice in_msg_body = ctx.at(BODY);
            slice sender = in_msg_body~load_msg_addr();
            throw_unless(error::unauthorized_swap_address, equal_slices(sender, storage::bc_swap_address));
        }
        lp_fee = bc_lp_fee;
        protocol_fee = bc_protocol_fee;
    }

    ;; LP fee paid in in_token
    int base_in_without_fee = muldiv(_amount_in, (params::fee_divider - lp_fee), params::fee_divider);

    if ((protocol_fee > 0) & (_side == 0)) {
        protocol_fee_ct = divc(base_in_without_fee * protocol_fee, params::fee_divider);
        base_in_without_fee -= protocol_fee_ct;
    }

    int base_out = calc_out_given_in(_reserve_in, base_in_without_fee, _reserve_out, base_usd_rate);

    if _ref_value > 0 {
        ref_fee_out = divc(base_out * _ref_value, params::fee_divider);
    }

    ;; pay other fees in out_token
    if ((protocol_fee > 0) & (_side != 0)) {
        protocol_fee_ct = divc(base_out * protocol_fee, params::fee_divider);
        base_out -= protocol_fee_ct;
    }

    base_out -= ref_fee_out;

    protocol_fee_out = muldiv(protocol_fee_ct, protocol_fee_pct, params::fee_divider);
    protocol_fee_ct -= protocol_fee_out;
    return (base_out, protocol_fee_out, ref_fee_out, protocol_fee_ct);
}

(int) pool::get_lp_provide_init_out(int _left_amount, int _right_amount) inline {
    if (storage::total_supply_lp == 0) {
        storage::bc_swap_address_expiration += now();
    }
    int inv0 = _invariant(_left_amount, _right_amount);
    return math::fp::to(inv0);
}

int div_up(int a, int b) inline {
    throw_if(math::error::zero_division, b == 0);
    return a == 0 ? 0 : muldiv(muldiv(a, math::ONE_DEC, 1) + b - 1, 1, b);
}

int mul_up(int a, int b) inline {
    if ((a == 0) | (b == 0)) { return 0; }
    return muldiv(muldiv(a, b, 1) + math::ONE_DEC - 1, 1, math::ONE_DEC);
}

int calculate_fee(int amount, int balance, int inv0, int inv1) inline_ref {
    int balance_ratio = div_up(inv1, inv0);
    int ideal_balance = mul_up(balance, balance_ratio);
    int diff = abs(balance + amount - ideal_balance);
    if (diff == 0) { return 0; }
    int discrepancy_ratio = muldiv(diff, math::ONE_DEC, ideal_balance);
    int dynamic_fee_rate = muldiv(discrepancy_ratio, discrepancy_ratio, params::max_fee);
    return muldiv(amount, dynamic_fee_rate, math::ONE_DEC);
}

(int, int, int) pool::get_lp_provide_out(int _left_amount, int _right_amount) impure inline {

    if (storage::ct_for_curve_phase != 0) {
        throw_if(error::add_liquidity_in_curve_mode, (_left_amount > 0) & (storage::reserve0 > 0));
        throw_if(error::add_liquidity_in_curve_mode, (_right_amount > 0) & (storage::reserve1 > 0));
    }

    int inv0 = _invariant(storage::reserve0, storage::reserve1);

    int new_reserve0 = storage::reserve0 + _left_amount;
    int new_reserve1 = storage::reserve1 + _right_amount;

    int inv1 = _invariant(new_reserve0, new_reserve1);
    if inv1 <= inv0 { return (0, 0, 0); }

    if (storage::ct_for_curve_phase == 0) {
        if (_left_amount > 0) {
            new_reserve0 -= calculate_fee(_left_amount, storage::reserve0, inv0, inv1);
        }
        if (_right_amount > 0) {
            new_reserve1 -= calculate_fee(_right_amount, storage::reserve1, inv0, inv1);
        }
    }
    int inv2 = _invariant(new_reserve0, new_reserve1);
    if inv2 <= inv0 { return (0, 0, 0); }

    return (muldiv((inv2 - inv0), storage::total_supply_lp, inv0), 0, 0);
}

(int, int) pool::get_lp_burn_out(int _lp_amount) impure inline {
    ;; get shares
    return (
        muldiv(_lp_amount, storage::reserve0, storage::total_supply_lp),
        muldiv(_lp_amount, storage::reserve1, storage::total_supply_lp)
    );
}
