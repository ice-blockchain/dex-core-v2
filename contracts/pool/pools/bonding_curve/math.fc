const _MAX_IN_RATIO = 300000000000000000; ;; 0.3e18
const ONE_GRAM = 1000000000;

const error::df_zero = 5104;
const error::log_domain_error = 5105;

int _invariant(int _left_balance, int _right_balance) {
    _left_balance = muldiv(_left_balance, ONE_GRAM, 1);
    _right_balance = muldiv(_right_balance, ONE_GRAM, 1);
    return math::fp::mul(_left_balance, _right_balance);
}

(int) _get_current_bonding_curve_price(int amount_in_fp, int s1_ct_sold_fp, int base_usd_rate_fp) impure inline {
    int A_coeff = storage::exp_A_coeff;
    int B_coeff = storage::exp_B_coeff;

    throw_if(error::df_zero, A_coeff == 0); ;; A should not be zero for the curve

    int amount_in_usd_fp = amount_in_fp.math::fp::mul(base_usd_rate_fp);

    if (B_coeff <= 0) {
        ;; Linear case if B is effectively zero (flat price A)
        return amount_in_usd_fp.math::fp::div(A_coeff);
    }

    int exp_arg = B_coeff.math::fp::mul(s1_ct_sold_fp);
    int exp_Bs1 = math::fp::exp(exp_arg);
    if (exp_Bs1 <= 0) { ;; switch to linear case
        return amount_in_usd_fp.math::fp::div(A_coeff);
    }

    ;; term_inside_ln = (amount_in_usd * B / A) + exp_Bs1
    int term_inside_ln_numerator = amount_in_usd_fp.math::fp::mul(B_coeff);
    int term_inside_ln_div_A = term_inside_ln_numerator.math::fp::div(A_coeff);
    int term_inside_ln_fp = term_inside_ln_div_A + exp_Bs1;

    throw_if(error::log_domain_error, term_inside_ln_fp <= 0); ;; log argument must be positive

    ;; s2 = (1 / B) * ln(term_inside_ln)
    int inv_B = math::ONE_DEC.math::fp::div(B_coeff); ;; 1/B
    int s2_calculated_scaled = inv_B.math::fp::mul(math::fp::ln(term_inside_ln_fp));

    ;; Calculate actual amount of CT to send out: amount_out_ct = s2 - s1
    int amount_out_ct = s2_calculated_scaled - s1_ct_sold_fp;
    if (amount_out_ct < 0) {
        amount_out_ct = 0;
    }

    return amount_out_ct;
}

int calc_out_given_in(int _balance_in, int _amount_in, int _balance_out, int base_usd_rate) inline {

    if (storage::ct_for_curve_phase > 0) { ;; === Bonding Curve Phase ===
        if (storage::ct_for_curve_phase < 100) {
            storage::ct_for_curve_phase = _balance_out - (storage::ct_for_curve_phase * _balance_out / 100);
        }

        ;; add decimals NOTE _balance_out and _amount_in are in GRAMS
        _balance_out = muldiv(_balance_out, ONE_GRAM, 1);
        _amount_in = muldiv(_amount_in, ONE_GRAM, 1);
        int ct_for_curve_phase = muldiv(storage::ct_for_curve_phase, ONE_GRAM, 1);

        int base_out = _get_current_bonding_curve_price(_amount_in, _balance_out, base_usd_rate);
        if (ct_for_curve_phase >= _balance_out - base_out) {
            storage::ct_for_curve_phase = 0;
        }
        ;; result without decimals
        return base_out / ONE_GRAM;
    } else {

        ;; add decimals
        _balance_in = _balance_in.math::fp::from();
        _amount_in = _amount_in.math::fp::from();

        throw_unless(error::max_in_ratio, _amount_in <= _balance_in.math::fp::mul(_MAX_IN_RATIO));

        int denominator = _balance_in + _amount_in;
        int base = _balance_in.math::fp::div_up(denominator);

        _balance_out = _balance_out.math::fp::from();
        ;; result without decimals
        return _balance_out.math::fp::mul(base.math::fp::complement()).math::fp::to();
    }
}
